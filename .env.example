# 複製成 .env（不要進 git），在部署主機上填實際值。

# ---- JWT：必須跟 ~/projects/Mini-SSO/.env 的 JWT_KEY / JWT_ISSUER / JWT_AUDIENCE 完全一樣 ----
JWT_KEY=please-change-to-the-same-key-as-mini-sso
JWT_ISSUER=yourdomain.com
JWT_AUDIENCE=yourdomain.com

# ---- 對外 port（Cloudflare Tunnel Public Hostname 指到 localhost:這個 port）----
WEB_PORT=12120
